# Database connection string (Neon Cloud PostgreSQL / Local Docker)
# Para Neon Cloud (Recomendado para el equipo):
# DATABASE_URL="postgresql://<usuario>:<password>@<endpoint>.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Para Docker Local:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/activacore?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/activacore?schema=public"

# NextAuth v5 / Auth.js configuration
AUTH_SECRET="activacore_super_secret_jwt_key_unapeclocal2026"
NEXTAUTH_SECRET="activacore_super_secret_jwt_key_unapeclocal2026"
NEXTAUTH_URL="http://localhost:3000"

